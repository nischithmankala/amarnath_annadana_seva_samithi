generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  PUBLIC
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum UserAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum MobileChangeStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  SUCCESSFUL
  PENDING
  FAILED
  REFUNDED
  CANCELLED
}

enum EventStatus {
  DRAFT
  UPCOMING
  LIVE
  COMPLETED
  ARCHIVED
}

enum CardStatus {
  ACTIVE
  REVOKED
}

enum AuditAction {
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  MOBILE_CHANGE_REQUESTED
  MOBILE_CHANGE_VERIFIED
  MOBILE_CHANGE_APPROVED
  MOBILE_CHANGE_REJECTED
  PROFILE_CHANGE_REQUESTED
  PROFILE_CHANGE_APPROVED
  PROFILE_CHANGE_REJECTED
  ROLE_CHANGED
  MEMBER_APPROVED
  MEMBER_REJECTED
  RECEIPT_REISSUED
  OTHER
}

// ==========================================
// AUTHENTICATION & USER IDENTITY
// ==========================================

model User {
  id                   String                @id @default(uuid())
  mobile               String                @unique // ONLY login identifier
  role                 Role                  @default(PUBLIC)
  accountStatus        UserAccountStatus     @default(PENDING)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  member               Member?
  auditLogs            AuditLog[]
  otpChallenges        OtpChallenge[]
  mobileChangeRequests MobileChangeRequest[]
}

model OtpChallenge {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash      String
  expiresAt    DateTime
  verifiedAt   DateTime?
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(3)
  resendCount  Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MobileChangeRequest {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentMobile   String
  requestedMobile String
  status          MobileChangeStatus @default(PENDING)
  requestedAt     DateTime           @default(now())
  verifiedAt      DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

// ==========================================
// MEMBER & PROFILE
// ==========================================

model Member {
  id             String       @id @default(uuid())
  memberId       String       @unique // Assigned after approval & payment
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  name           String
  photoUrl       String?
  email          String?      // Contact info only, NOT for login
  address        String?
  city           String?
  occupation     String?
  dob            DateTime?
  dateOfMarriage DateTime?
  category       String?
  fee            Float?
  validityPeriod DateTime?
  status         MemberStatus @default(PENDING)
  joiningDate    DateTime?
  
  // Privacy & visibility configurations
  consentFlags   Json?        // e.g. { showPhoto: true, showEmail: false, ... }

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  familyMembers         FamilyMember[]
  payments              Payment[]
  profileChangeRequests ProfileChangeRequest[]
  virtualCard           VirtualMemberCard?
}

model ProfileChangeRequest {
  id               String              @id @default(uuid())
  memberId         String
  member           Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  requestedChanges Json                // JSON storing the diff or new values
  status           ProfileChangeStatus @default(PENDING)
  requestedAt      DateTime            @default(now())
  approvedAt       DateTime?
  approvedBy       String?
  rejectionReason  String?

  @@index([memberId])
  @@index([status])
}

model FamilyMember {
  id              String    @id @default(uuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name            String
  relationship    String
  dob             DateTime?
  contactInfo     String?
  approvedVisible Boolean   @default(false)
  photoUrl        String?

  @@index([memberId])
}

model VirtualMemberCard {
  id          String     @id @default(uuid())
  memberId    String     @unique
  member      Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cardVersion Int        @default(1)
  issuedAt    DateTime   @default(now())
  status      CardStatus @default(ACTIVE)
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ==========================================
// PAYMENTS & TRANSACTIONS
// ==========================================

model Payment {
  id             String        @id @default(uuid())
  transactionRef String        @unique
  receiptNumber  String?       @unique
  amount         Float
  gatewayRef     String?
  paymentMethod  String?
  status         PaymentStatus @default(PENDING)
  purpose        String?
  memberId       String?
  member         Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  receipts       Receipt[]
  donations      Donation[]
  sponsorships   Sponsorship[]

  @@index([memberId])
  @@index([transactionRef])
  @@index([receiptNumber])
}

model Receipt {
  id               String   @id @default(uuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receiptNumber    String   @unique
  generatedAt      DateTime @default(now())
  generatedBy      String?
  reasonForReissue String?

  @@index([paymentId])
}

model Donation {
  id        String   @id @default(uuid())
  donorName String
  mobile    String?
  email     String?
  address   String?
  pan       String?
  amount    Float
  campaign  String?
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([paymentId])
}

model Sponsorship {
  id             String   @id @default(uuid())
  sponsorDetails String
  package        String?
  amount         Float?
  consentPublic  Boolean  @default(true)
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@index([paymentId])
}

// ==========================================
// EVENTS & OPERATIONS
// ==========================================

model Event {
  id                  String      @id @default(uuid())
  title               String
  description         String?
  dateTime            DateTime
  location            String?
  category            String?
  status              EventStatus @default(DRAFT)
  registrationRules   String?
  sponsorshipPackages Json?
  galleryLinks        Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  volunteers          Volunteer[]
}

model Volunteer {
  id         String @id @default(uuid())
  name       String
  contact    String
  skills     String?
  status     String @default("submitted")
  assignedBy String?
  eventId    String
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model BoardRecord {
  id           String   @id @default(uuid())
  year         Int
  name         String
  photoUrl     String?
  designation  String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model MediaAsset {
  id            String   @id @default(uuid())
  title         String?
  caption       String?
  altText       String?
  category      String?
  fileUrl       String
  fileSize      Int?
  fileType      String?
  publishStatus Boolean  @default(true)
  displayOrder  Int      @default(0)
  uploadedBy    String?
  createdAt     DateTime @default(now())
}

// ==========================================
// SYSTEM LOGS
// ==========================================

model AuditLog {
  id          String      @id @default(uuid())
  actorId     String?
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      AuditAction
  beforeState Json?
  afterState  Json?
  createdAt   DateTime    @default(now())

  @@index([actorId])
  @@index([createdAt])
}
